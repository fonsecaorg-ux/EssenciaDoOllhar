# Copie para .env e preencha com as credenciais do seu projeto Supabase.
# Sem essas variáveis o app roda com os dados fictícios de src/data/mock.js.
#
# Use a chave pública (publishable) ou a legada "anon public".
# NUNCA use a secret / service_role no frontend.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
# Alternativa legada (se o seu projeto ainda usa JWT anon):
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
